---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Recordings from the Jack Night DJ nights." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <style is:global>
      body {
        font-family: monospace;
        padding: 0 12px;
      }
      audio {
        width: 100%;
        display: block;
        margin: 4px 0;
      }
      /* player.ts drops the native controls and inserts .bar in their place.
         Without JS the element keeps them and stays visible. */
      audio:not([controls]) {
        display: none;
      }
      .bar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 4px 0;
      }
      .bar .toggle {
        font: inherit;
        width: 2.5em;
        cursor: pointer;
        color: inherit;
        background: none;
        border: 1px solid currentColor;
        border-radius: 2px;
        opacity: 0.6;
      }
      .bar .toggle:hover,
      .bar .toggle:focus-visible {
        opacity: 1;
      }
      .bar .scrub {
        flex: 1;
        min-width: 0;
        accent-color: currentColor;
      }
      .bar .time {
        opacity: 0.55;
        font-size: 0.85em;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      /* A cold start on an hour-long file is not instant. */
      .bar[data-loading] .time::after {
        content: " ...";
      }
      li {
        margin-bottom: 12px;
      }
      /* A heading you land on shouldn't sit flush against the viewport edge. */
      :target {
        scroll-margin-top: 12px;
      }
      /* Headings read as text; the # only shows when you go looking for it. */
      .anchor {
        color: inherit;
        text-decoration: none;
      }
      .anchor::after {
        content: " #";
        opacity: 0;
      }
      .anchor:hover::after,
      .anchor:focus-visible::after {
        opacity: 0.4;
      }
      /* One row in a page of near-identical rows: mark the one that was linked. */
      :target > .anchor {
        text-decoration: underline;
      }
      /* Duration, size and the FLAC link. Deliberately quiet -- the track
         names stay the thing you read. */
      .meta {
        opacity: 0.55;
        font-size: 0.85em;
      }
      .meta a {
        color: inherit;
      }
      @media (prefers-color-scheme: dark) {
        body {
          color: white;
          background-color: black;
        }
      }
    </style>
  </body>
</html>
