---
import { audioFor, formatBytes, formatDuration } from "../lib/audio";
import { uniqueSlugs, type Night } from "../lib/sets";

interface Props {
    set: Night;
    /** Anchor for the heading, so a night can be linked to directly. */
    id: string;
}

const { set, id } = Astro.props;
const { title, note, numbered, tracks } = set;
const List = numbered ? "ol" : "ul";

// Prefixed by the night, so the same DJ on two nights gets two links.
const trackIds = uniqueSlugs(tracks.map((t) => t.name)).map((s) => `${id}-${s}`);

const MIME: Record<string, string> = {
    flac: "audio/flac",
    aac: "audio/mp4",
    mp3: "audio/mpeg",
    vorbis: "audio/ogg",
    opus: "audio/ogg",
};
const mimeFor = (codec: string) => MIME[codec] ?? "audio/mpeg";

/** Media Session title: "ARTIST @ EVENT", with parts and variants distinguished. */
function mediaTitle(
    artist: string,
    label: string | undefined,
    index: number,
    total: number,
) {
    const base = `${artist} @ ${title}`;
    if (label) return `${base} — ${label}`;
    return total > 1 ? `${base} (Part ${index + 1})` : base;
}
---

<h2 id={id}><a class="anchor" href={`#${id}`}>{title}</a></h2>
{
    note && (
        <h3 id={`${id}-note`}>
            <a class="anchor" href={`#${id}-note`}>
                <i>{note}</i>
            </a>
        </h3>
    )
}
<List>
    {
        tracks.map((track, t) => {
            const labelled = track.sources.some((s) => s.label);
            // preload="none" so a page of players costs nothing until one is pressed.
            // Sources run smallest-first, ending at the original, so playback never
            // depends on a transcode having happened.
            const players = track.sources.map((source, i) => {
                const info = audioFor(source.file);
                return (
                    <>
                        <audio
                            controls
                            preload="metadata"
                            data-key={source.file}
                            data-title={mediaTitle(
                                track.artist ?? track.name,
                                source.label,
                                i,
                                track.sources.length,
                            )}
                            data-artist={track.artist ?? track.name}
                            data-album={title}
                            data-duration={info.duration}
                        >
                            {info.opus && (
                                <source
                                    src={info.opus.url}
                                    type="audio/ogg; codecs=opus"
                                />
                            )}
                            {info.aac && (
                                <source
                                    src={info.aac.url}
                                    type="audio/mp4; codecs=mp4a.40.2"
                                />
                            )}
                            <source src={info.src} type={mimeFor(info.codec)} />
                        </audio>
                        {/* Duration comes from the manifest, not the player: with preload="none"
                the control reads 0:00 until pressed, and preloading every player
                instead trips a browser cap on concurrent media loads. */}
                        <span class="meta">
                            {formatDuration(info.duration)}
                            {info.channels === 1 && " · mono"}
                            {" · "}
                            <a href={info.src} download>
                                {source.file.split(".").pop()}{" "}
                                {formatBytes(info.bytes)}
                            </a>
                        </span>
                    </>
                );
            });

            return (
                <li id={trackIds[t]}>
                    <a class="anchor" href={`#${trackIds[t]}`}>
                        {track.name}
                    </a>
                    {labelled ? (
                        <ul>
                            {track.sources.map((source, i) => (
                                <li>
                                    <p>{source.label}</p>
                                    {players[i]}
                                </li>
                            ))}
                        </ul>
                    ) : (
                        players
                    )}
                    {track.setlist && (
                        <details>
                            <summary>Setlist</summary>
                            <ol>
                                {track.setlist.map((entry) => (
                                    <li>{entry}</li>
                                ))}
                            </ol>
                        </details>
                    )}
                </li>
            );
        })
    }
</List>
