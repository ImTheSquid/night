---
import Set from "./Set.astro";
import { nightIds, warnUnlisted, type Night } from "../lib/sets";

interface Props {
  sets: Night[];
}

const { sets } = Astro.props;

// Ids are assigned here rather than in <Set> so collisions can be seen and
// broken across the whole page.
const ids = nightIds(sets);

// Build-time only: flags audio on the server that no page lists.
await warnUnlisted();
---

{sets.map((set, i) => <Set set={set} id={ids[i]} />)}

<script src="../scripts/player.ts"></script>
<script src="../scripts/album.ts"></script>
